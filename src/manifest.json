{
  "manifest_version": 3,
  "name": "Explain as I'm 5 - Gemini Edition",
  "version": "1.0",
  "description": "A Chrome extension that uses Gemini API to explain complex topics in simple terms.",
  "permissions": ["contextMenus", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ]
}
